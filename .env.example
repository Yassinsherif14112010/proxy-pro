# انسخ الملف باسم .env أو حط القيم كمتغيرات بيئة قبل التشغيل
PORT=8080
# عدد العمليات: 1 للأجهزة الضعيفة/الموبايل، 2-4 للسيرفر القوي
WORKERS=2
# حماية بروكسي الشبكة بيوزر وباسورد (اختياري، اتركه فاضي = بدون حماية)
PROXY_USER=
PROXY_PASS=
# حدود لكل مستخدم (IP)
MAX_TUNNELS_PER_IP=150
REQ_PER_SEC_PER_IP=60
REQ_BURST_PER_IP=200
